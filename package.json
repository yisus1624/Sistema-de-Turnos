{
  "name": "sistema-turnos-hospital",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/patch-minimatch-brace-expansion.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --import ./tests/register-alias.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "bcryptjs": "^2.4.3",
    "geist": "^1.7.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.72.1",
    "sileo": "^0.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.24",
    "eslint": "9.39.3",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "brace-expansion": "5.0.8"
  }
}
