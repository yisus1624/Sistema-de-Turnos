# Variables de entorno del sistema de turnos.
#
# Copiar a `.env.local` y rellenar. Este archivo de ejemplo NUNCA lleva valores
# reales: es lo unico de la familia `.env*` que se versiona.

# --- Sesion (obligatorio) ---------------------------------------------------

# Clave con la que se firman las sesiones. Si falta, la aplicacion no arranca.
# Generar una larga y aleatoria, distinta en cada servidor:  openssl rand -base64 32
NEXTAUTH_SECRET=

# Direccion publica del sistema, tal como la escriben los funcionarios.
# Ej: http://192.168.1.50:3000  o  https://turnos.hospital.local
NEXTAUTH_URL=

# --- Cuentas semilla (TEMPORAL) ---------------------------------------------
#
# Existen solo mientras el hospital no confirme como se autentican sus
# funcionarios (ver lib/hospital/README.md). Con la fuente real, sobran.
#
# CAMBIARLAS ANTES DE PONER EL SISTEMA EN LA RED: si se dejan sin definir, el
# sistema arranca con admin/admin1234, que es publico y esta en el codigo.
TURNOS_ADMIN_USUARIO=
TURNOS_ADMIN_PASSWORD=
TURNOS_OPERADOR_USUARIO=
TURNOS_OPERADOR_PASSWORD=

# --- Despliegue -------------------------------------------------------------

# Poner en 1 SOLO si hay un proxy inverso (nginx, Caddy, Apache) que sea el
# unico camino hacia la aplicacion. Entonces se confia en la cabecera
# X-Forwarded-For para saber la IP del cliente, y se activa el limite de
# intentos de entrada por IP.
#
# Sin proxy hay que dejarla vacia: esa cabecera la puede escribir cualquiera, y
# confiar en ella daria una proteccion falsa. El limite por USUARIO, que es el
# que de verdad frena la fuerza bruta, funciona igual en los dos casos.
TURNOS_CONFIAR_PROXY=

# Poner en 1 para exigir HTTPS (cabecera Strict-Transport-Security).
#
# ENCENDERLA SOLO CUANDO EL CERTIFICADO YA FUNCIONE Y SE HAYA COMPROBADO QUE
# TODOS ENTRAN, incluido el televisor de la sala de espera. Una vez que un
# navegador recibe esa cabecera se niega a entrar por http a este servidor
# durante un ano, y no se puede deshacer desde el servidor: hay que ir maquina
# por maquina.
TURNOS_HSTS=

# Poner en 1 para habilitar el panel de simulacion de carga (/admin/pruebas).
#
# ESE PANEL BORRA LAS CITAS Y LOS TURNOS DEL DIA. Dejar vacia en produccion.
TURNOS_SIMULACION=
