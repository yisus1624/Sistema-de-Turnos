# Variables de entorno del Sistema de Turnos.
#
# Copiar a `.env.local` y rellenar. ESTE ARCHIVO NUNCA LLEVA VALORES REALES:
# se versiona para documentar que hace falta al desplegar (ver
# docs/despliegue.md).

# --- Base de datos -----------------------------------------------------------
# Cadena de conexion de PostgreSQL. Obligatoria.
#
# `connection_limit` ACOTA EL POOL: sin el, Prisma abre conexiones segun los
# nucleos de la maquina y un pico de consultas puede dejar a la base sin
# conexiones para el inicio de sesion y el llamado. `pool_timeout` (segundos)
# hace que una peticion que no consigue conexion falle pronto en vez de colgar.
# Ver docs/despliegue.md, seccion 3.
#
# !! connection_limit=1 SERIALIZA TODO: cada "Llamar siguiente", "Atendido" o
# registro de llegada ocupa la unica conexion mientras dura su transaccion, y
# los demas consultorios esperan en fila (y tras 5 s fallan con "el sistema esta
# muy ocupado"). En produccion se recomienda 10. Como calcularlo: el pool del
# servidor de conexiones (pgbouncer / Supabase "pool size") dividido entre las
# instancias de la aplicacion, dejando margen para migraciones y consultas a
# mano. Con Supabase y una sola instancia, 10 cabe en el pool por defecto.
DATABASE_URL=postgresql://usuario:contrasena@servidor:5432/turnos?connection_limit=10&pool_timeout=10

# --- Sesiones ----------------------------------------------------------------
# Obligatoria: sin ella no se firman las sesiones y nadie puede entrar.
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=
# La direccion por la que entra el hospital (con https una vez montado).
NEXTAUTH_URL=http://localhost:3000

# --- Cifrado de secretos recuperables ----------------------------------------
# OPCIONAL. Cifra la copia del enlace de consultorio que el sistema guarda para
# poder volver a mostrarlo mientras dura el turno del doctor (sin ella se usa
# NEXTAUTH_SECRET, asi que el sistema funciona igual sin configurarla).
#
# Conviene ponerla aparte para poder rotarla sin cerrar las sesiones de todo el
# mundo. Al rotarla, los enlaces que estuvieran vivos dejan de poder mostrarse
# —hay que generarlos de nuevo—, pero nada mas se pierde.
# Generar con: openssl rand -base64 32
TURNOS_CLAVE_SECRETOS=

# --- Cuentas semilla ---------------------------------------------------------
# Las crea `npm run db:seed`, una sola vez.
#
# OBLIGATORIAS EN PRODUCCION. Las contrasenas por defecto estan escritas en el
# repositorio y son publicas: con ellas, cualquiera que lo haya visto entra
# como ADMINISTRADOR. Por eso el seed se NIEGA a correr en produccion sin
# estas variables, y tambien si traen la contrasena de ejemplo o una de menos
# de 12 caracteres.
TURNOS_ADMIN_USUARIO=admin
TURNOS_ADMIN_PASSWORD=
TURNOS_OPERADOR_USUARIO=operador
TURNOS_OPERADOR_PASSWORD=

# --- Red y proxy -------------------------------------------------------------
# Poner en 1 SOLO si hay un proxy inverso delante que sea el unico camino hasta
# la aplicacion. Sin proxy, la IP la escribe el propio cliente y no sirve ni
# para limitar ni para investigar. Con proxy se activan los frenos por IP, que
# son amplios a proposito: todo el hospital sale por una sola IP y no la
# alcanza nunca. La proteccion fina va por cuenta, por enlace y por sesion.
# Con 0, no hay IP: los limites por cuenta de TODOS los equipos cuentan juntos
# bajo un mismo origen ("sin-ip-de-fiar"), y no hay limites por IP.
TURNOS_CONFIAR_PROXY=0

# HTTPS obligatorio en el navegador (HSTS). LO ULTIMO que se enciende, y solo
# con el certificado ya funcionando: no hay forma de desdecirlo desde el
# servidor. SE LEE AL COMPILAR: hay que volver a ejecutar `npm run build`.
TURNOS_HSTS=0

# --- Canal de eventos en vivo (SSE) ------------------------------------------
# Conexiones simultaneas que admite `GET /api/turnos/stream`. Es una ruta
# publica: el tope global evita que un bucle de conexiones agote la memoria y
# deje sin pantalla a toda la sala de espera. Por defecto 2000.
# TURNOS_MAX_CANAL_EN_VIVO=2000
# Conexiones simultaneas por IP. Solo se aplica con TURNOS_CONFIAR_PROXY=1.
# ALTO A PROPOSITO: todo el hospital sale por UNA IP (que cambia sin aviso y no
# se configura en ninguna parte). 100 cubre ~30 pantallas mas la reconexion
# masiva tras un corte, mientras el servidor recicla las conexiones colgadas
# cada 4 a 6 minutos; y frena a una IP que abre cientos. Por defecto 100.
# TURNOS_MAX_CANAL_EN_VIVO_POR_ORIGEN=100

# --- Consultas caras -----------------------------------------------------------
# Cuantas consultas caras (historico, estadisticas, importar, purga) corren a la
# vez en todo el servidor. Tiene que quedar por debajo del connection_limit de
# DATABASE_URL, para que siempre sobren conexiones para el llamado. Por defecto 4.
# TURNOS_MAX_CONSULTAS_PESADAS=4

# --- Panel de simulacion -----------------------------------------------------
# BORRA las citas y los turnos del dia. Nunca en el servidor del hospital.
TURNOS_SIMULACION=0
